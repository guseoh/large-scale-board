    {
      "type": "stat",
      "title": "long_query_time",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "mysql_global_variables_long_query_time{job=\"mysql\"}",
          "legendFormat": "기준",
          "range": true
