# 실험 조건으로 고정하는 MySQL 설정. 값을 바꾸면 실험 기록에 적는다. (Step-0-Design 9절)
[mysqld]
# 데이터(ds-v1: 수천만 건)가 버퍼 풀보다 훨씬 커야 디스크 읽기 병목이 드러난다.
innodb_buffer_pool_size = 512M

# 100ms 넘는 쿼리를 기록한다. 파일은 데이터 볼륨 안에 남는다.
slow_query_log = ON
long_query_time = 0.1
slow_query_log_file = /var/lib/mysql/slow-query.log

# 복원 직후의 버퍼 풀 상태를 항상 같게(비어 있게) 만든다.
# 켜 두면 이전 실행의 캐시가 다음 측정을 빠르게 만든다.
innodb_buffer_pool_dump_at_shutdown = OFF
innodb_buffer_pool_load_at_startup = OFF

# 기본값이지만 실험 조건으로 기록하려고 명시한다. 커밋마다 redo 로그를 디스크에 내린다(내구성 최대).
innodb_flush_log_at_trx_commit = 1
